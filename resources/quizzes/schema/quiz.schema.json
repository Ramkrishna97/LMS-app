{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learnhub.local/schemas/quiz.schema.json",
  "title": "LearnHub quiz import",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "description", "durationMinutes", "questions"],
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 255 },
    "description": { "type": "string", "minLength": 1 },
    "durationMinutes": { "type": "integer", "minimum": 1 },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/question" }
    }
  },
  "$defs": {
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questionText", "optionA", "optionB", "optionC", "optionD", "correctOption", "solution"],
      "properties": {
        "questionText": { "type": "string", "minLength": 1, "maxLength": 255 },
        "optionA": { "type": "string", "minLength": 1, "maxLength": 255 },
        "optionB": { "type": "string", "minLength": 1, "maxLength": 255 },
        "optionC": { "type": "string", "minLength": 1, "maxLength": 255 },
        "optionD": { "type": "string", "minLength": 1, "maxLength": 255 },
        "correctOption": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "description": "Zero-based answer index: 0=A, 1=B, 2=C, 3=D."
        },
        "solution": { "type": "string", "minLength": 1, "maxLength": 255 }
      }
    }
  }
}
